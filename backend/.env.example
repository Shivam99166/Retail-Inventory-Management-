# RetailHub Backend Environment Variables Template
# Copy this file to .env or configure your system environment variables.

# PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/retail_inventory
DB_USERNAME=postgres
DB_PASSWORD=your_secure_db_password

# Spring Profiles: dev (local testing) or prod (production)
SPRING_PROFILES_ACTIVE=dev

# JWT Configuration (Mandatory in production: >= 32 characters / 256 bits)
JWT_SECRET=YourCryptographicallySecureKeyAtLeast32CharsLong!

# Application Port
SERVER_PORT=8080
