# ===================================================================
# RetailHub Backend Environment Variables Template
# Copy this file to .env for local testing or configure these in Render.
# ===================================================================

# Active Spring Profile ('dev' for local testing, 'prod' for public production deployment)
SPRING_PROFILES_ACTIVE=prod

# Server Port (Render injects this dynamically; default 8080)
PORT=8080

# PostgreSQL Database Configuration
# Cloud PostgreSQL JDBC connection URL (Render Postgres, Supabase, Neon, AWS RDS, etc.)
# Format: jdbc:postgresql://<host>:<port>/<dbname>?sslmode=require
DB_URL=jdbc:postgresql://your-cloud-db-host:5432/retail_inventory?sslmode=require
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# Database Connection Pool Settings (Optional overrides for HikariCP)
DB_POOL_MAX=10
DB_POOL_MIN=2

# JPA / Hibernate DDL behavior ('update' keeps schema in sync safely)
JPA_DDL_AUTO=update

# Mandatory Production JWT Signing Secret
# Must be at least 32 characters (256 bits) for HS256 HMAC algorithm.
# Startup will fail immediately if unset or shorter than 32 characters in 'prod'.
JWT_SECRET=YourProductionSecretKeyMustBe32CharsOrLonger2026!

# JWT Token Expiration in milliseconds (Default: 86400000 = 24 hours)
JWT_EXPIRATION=86400000

# CORS Allowed Origins
# Comma-separated list of allowed frontend URLs (e.g. your Vercel deployment URL)
CORS_ALLOWED_ORIGINS=https://your-retailhub-frontend.vercel.app,http://localhost:5173
